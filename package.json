{

  "type": "module",

  "name": "@kishorekumarselvarajan/my-test-package-components",

  "version": "0.2.2",

  "description": "A collection of reusable React UI components",

  "private": false,

  "license": "MIT",

  "author": "Kishore Kumar Selvarajan",

  "repository": {

    "type": "git",

    "url": "git+https://github.com/kishorekumarassaabloy0709/my-test-package-components.git"

  },

  "homepage": "https://github.com/kishorekumarassaabloy0709/my-test-package-components",

  "bugs": {

    "url": "https://github.com/kishorekumarassaabloy0709/my-test-package-components/issues"

  },

  "keywords": [

    "react",

    "components",

    "ui",

    "library",

    "typescript"

  ],

  "main": "dist/index.js",

  "module": "dist/index.esm.js",

  "types": "dist/index.d.ts",

  "exports": {

    ".": {

      "import": "./dist/index.esm.js",

      "require": "./dist/index.js",

      "types": "./dist/index.d.ts"

    }

  },

  "files": [

    "dist",

    "README.md"

  ],

  "publishConfig": {

    "access": "public"

  },

  "scripts": {

    "dev": "next dev",

    "build": "next build",

    "build:lib": "rollup -c",

    "start": "next start",

    "lint": "eslint",

    "prepublishonly": "npm run build:lib"

  },

  "peerDependencies": {

    "react": "^18.0.0 || ^19.0.0",

    "react-dom": "^18.0.0 || ^19.0.0"

  },

  "dependencies": {

    "next": "16.3.4"

  },

  "devDependencies": {

    "@rollup/plugin-node-resolve": "^15",

    "@rollup/plugin-typescript": "^11",

    "@tailwindcss/postcss": "^4",

    "@types/node": "^20",

    "@types/react": "^19",

    "@types/react-dom": "^19",

    "eslint": "^9",

    "eslint-config-next": "16.3.4",

    "rollup": "^4",

    "rollup-plugin-peer-deps-external": "^2",

    "rollup-plugin-postcss": "^4",

    "tailwindcss": "^4",

    "tslib": "^2",

    "typescript": "^5",

    "react": "^19.0.0",

    "react-dom": "^19.0.0"

  }

}